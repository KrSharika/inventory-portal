<mvc:View
    controllerName="novamart.inventory.controller.App"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.f"
    xmlns:m="sap.m"
    displayBlock="true"
    height="100%">
    <m:Page id="appPage" title="{i18n>appTitle}" showHeader="true" height="100%">
        <m:headerContent>
            <m:Button
                id="settingsButton"
                icon="sap-icon://action-settings"
                tooltip="{i18n>tooltipSettings}"
                press="onSettingsPress" />
        </m:headerContent>
        <m:content>
            <FlexibleColumnLayout id="fcl" layout="{appView>/layout}" backgroundDesign="Solid" />
        </m:content>
    </m:Page>
</mvc:View>
<mvc:View
    controllerName="novamart.inventory.controller.Category"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page
        id="categoryPage"
        title="{i18n>categoryPageTitle}"
        showNavButton="false">
        <content>
            <List
                id="categoryList"
                items="{categories>/categories}"
                mode="SingleSelectMaster"
                itemPress="onCategoryPress"
                noDataText="{i18n>emptyCategoryText}">
                <items>
                    <ObjectListItem
                        type="Navigation"
                        title="{categories>category}"
                        number="{categories>count}"
                        numberUnit="{i18n>productsUnit}">
                        <firstStatus>
                            <ObjectStatus
                                text="{categories>statusText}"
                                state="{categories>statusState}"
                                icon="{categories>statusIcon}" />
                        </firstStatus>
                    </ObjectListItem>
                </items>
            </List>
        </content>
    </Page>
</mvc:View>
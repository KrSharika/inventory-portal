<mvc:View
    controllerName="novamart.inventory.controller.List"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page
        id="listPage"
        title="{appView>/categoryId}"
        busy="{appView>/busy}"
        showNavButton="true"
        navButtonPress="onNavBack">
        <customHeader>
            <Bar class="novaMartHeaderBar">
                <contentLeft>
                    <Text text="" width="7rem" />
                </contentLeft>
                <contentMiddle>
                    <Title text="{i18n>listPageTitle}" level="H2" class="novaMartHeaderTitle" />
                </contentMiddle>
                <contentRight>
                    <Text text="{= ${appView>/productCount} + ' ' + ${i18n>productCountLabel} }" class="novaMartHeaderCount" />
                    <Select
                        id="languageSelect"
                        selectedKey="{appView>/locale}"
                        change="onLanguageChange"
                        class="sapUiTinyMarginBegin"
                        width="7rem">
                        <core:Item key="en" text="English" />
                        <core:Item key="de" text="Deutsch" />
                    </Select>
                </contentRight>
            </Bar>
        </customHeader>
        <subHeader>
            <Toolbar>
                <SearchField
                    id="searchField"
                    width="60%"
                    placeholder="{i18n>searchPlaceholder}"
                    liveChange="onSearch" />
                <ToolbarSpacer />
                <Button icon="sap-icon://sort" tooltip="{i18n>buttonSort}" press="onOpenViewSettings" />
                <Button icon="sap-icon://filter" tooltip="{i18n>buttonFilter}" press="onOpenViewSettings" />
                <Button icon="sap-icon://group-2" tooltip="{i18n>buttonGroup}" press="onOpenViewSettings" />
                <Button icon="sap-icon://add" text="{i18n>buttonAdd}" type="Emphasized" press="onAddProduct" />
            </Toolbar>
        </subHeader>
        <List
            id="productList"
            items="{products>/products}"
            noDataText="{i18n>emptyListText}"
            mode="SingleSelectMaster"
            itemPress="onProductPress"
            growing="true"
            growingThreshold="20">
            <items>
                <ObjectListItem
                    type="Navigation"
                    title="{products>name}"
                    number="{
                        parts: [
                            {path: 'products>price'},
                            {path: 'products>currency'}
                        ],
                        formatter: '.formatter.currencyValue'
                    }"
                    numberUnit="{products>currency}">
                    <firstStatus>
                        <ObjectStatus
                            text="{
                                parts: [
                                    {path: 'products>stock'},
                                    {path: 'products>reorderThreshold'},
                                    {path: 'i18n>statusAvailable'},
                                    {path: 'i18n>statusLowStock'},
                                    {path: 'i18n>statusOutOfStock'}
                                ],
                                formatter: '.formatter.statusText'
                            }"
                            state="{
                                parts: [
                                    {path: 'products>stock'},
                                    {path: 'products>reorderThreshold'}
                                ],
                                formatter: '.formatter.statusState'
                            }"
                            icon="{
                                parts: [
                                    {path: 'products>stock'},
                                    {path: 'products>reorderThreshold'}
                                ],
                                formatter: '.formatter.statusIcon'
                            }" />
                    </firstStatus>
                    <attributes>
                        <ObjectAttribute text="{products>category}" />
                    </attributes>
                </ObjectListItem>
            </items>
        </List>
    </Page>
</mvc:View>